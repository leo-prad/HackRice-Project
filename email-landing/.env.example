# Copy this file to .env in this folder (email-landing/.env) — Vite does not load .env.example
VITE_MICROSOFT_CLIENT_ID=
# Express API base URL. Recommended dev: Vite on 3000, API on 5173 (see root README).
VITE_API_URL=http://localhost:5173
# Dev defaults to guest mode (landing at /). Set 0 to test signed-in / OAuth flows.
# VITE_FORCE_GUEST=0
