{
  "manifest_version": 3,
  "name": "GitQuest",
  "version": "0.1.0",
  "description": "Turn live GitHub issues into RPG-style coding quests.",
  "permissions": ["storage"],
  "host_permissions": ["https://github.com/*", "http://localhost:8787/*"],
  "action": { "default_popup": "popup/popup.html" },
  "background": { "service_worker": "background/service-worker.js", "type": "module" },
  "content_scripts": [{
    "matches": ["https://github.com/*"],
    "js": ["content/index.js"],
    "css": ["content/styles.css"],
    "run_at": "document_idle"
  }]
}
